{
  "formatId": "configureme/linux-catalog",
  "schemaVersion": 1,
  "target": {
    "os": "ubuntu-24.04",
    "codename": "noble",
    "architecture": "amd64"
  },
  "sources": {
    "ubuntu-archive": {
      "kind": "distribution-archive",
      "pinned": false
    },
    "docker-apt-repository": {
      "kind": "apt-repository",
      "pinned": true,
      "uri": "https://download.docker.com/linux/ubuntu",
      "suite": "noble",
      "components": "stable",
      "architecture": "amd64",
      "keyUrl": "https://download.docker.com/linux/ubuntu/gpg",
      "keyFingerprint": "9DC858229FC7DD38854AE2D88D81803C0EBFCD88",
      "keyPath": "/etc/apt/keyrings/docker.asc",
      "sourcesPath": "/etc/apt/sources.list.d/docker.sources"
    }
  },
  "steps": [
    {
      "id": "base-tools",
      "title": "Basiswerkzeuge aus dem Ubuntu-Archiv",
      "dependsOn": [],
      "packages": [
        { "name": "ca-certificates" },
        { "name": "curl" },
        { "name": "git" },
        { "name": "gnupg" }
      ]
    },
    {
      "id": "docker-apt-repository",
      "title": "Offizielles Docker-APT-Repository mit festem Schlüssel",
      "dependsOn": ["base-tools"],
      "packages": []
    },
    {
      "id": "docker-engine",
      "title": "Docker Engine und Compose-Plugin in exakten Versionen",
      "dependsOn": ["docker-apt-repository"],
      "packages": [
        { "name": "docker-ce", "version": "5:29.9.3-1~ubuntu.24.04~noble" },
        { "name": "docker-ce-cli", "version": "5:29.9.3-1~ubuntu.24.04~noble" },
        { "name": "containerd.io", "version": "2.4.2-4~ubuntu.24.04~noble" },
        { "name": "docker-buildx-plugin", "version": "0.39.0-1~ubuntu.24.04~noble" },
        { "name": "docker-compose-plugin", "version": "5.7.1-1~ubuntu.24.04~noble" }
      ]
    },
    {
      "id": "unattended-upgrades",
      "title": "Automatische Sicherheitsupdates ohne automatischen Neustart",
      "dependsOn": [],
      "packages": [
        { "name": "unattended-upgrades" }
      ]
    },
    {
      "id": "tool-jq",
      "title": "jq – JSON in der Shell lesen und filtern",
      "dependsOn": [],
      "packages": [{ "name": "jq" }]
    },
    {
      "id": "tool-python3-venv",
      "title": "python3-venv – isolierte Python-Umgebungen",
      "dependsOn": [],
      "packages": [{ "name": "python3-venv" }]
    },
    {
      "id": "tool-htop",
      "title": "htop – Prozesse und Last ansehen",
      "dependsOn": [],
      "packages": [{ "name": "htop" }]
    },
    {
      "id": "tool-tmux",
      "title": "tmux – SSH-Sitzungen, die Verbindungsabbrüche überleben",
      "dependsOn": [],
      "packages": [{ "name": "tmux" }]
    },
    {
      "id": "tool-unzip",
      "title": "unzip – ZIP-Archive entpacken",
      "dependsOn": [],
      "packages": [{ "name": "unzip" }]
    },
    {
      "id": "tool-rsync",
      "title": "rsync – Dateien und Backups effizient kopieren",
      "dependsOn": [],
      "packages": [{ "name": "rsync" }]
    },
    {
      "id": "tool-ncdu",
      "title": "ncdu – Plattenbelegung finden",
      "dependsOn": [],
      "packages": [{ "name": "ncdu" }]
    },
    {
      "id": "tool-tree",
      "title": "tree – Verzeichnisstruktur anzeigen",
      "dependsOn": [],
      "packages": [{ "name": "tree" }]
    }
  ]
}
