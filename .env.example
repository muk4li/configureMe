# Local development example only. No working credentials or default admin.
# For deployment choose the reviewed external HTTPS origin; production OAuth
# deliberately refuses an HTTP callback URL. Public preview needs no OAuth.
APP_URL=http://localhost:3000
HOST_PORT=3000

# Optional private portal: supply real values only in ignored runtime env files.
# Empty defaults keep authentication unavailable; never commit generated secrets.
AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
INITIAL_ADMIN_GITHUB_USER=
ALLOWED_GITHUB_USERS=

# Optional exact source SHA for unsigned development bundle metadata, not trust.
CONFIGUREME_SOURCE_COMMIT=
